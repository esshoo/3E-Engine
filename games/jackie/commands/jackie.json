{
  "schemaVersion": 1,
  "commands": [
    {
      "id": "jackie.play",
      "action": {
        "type": "builtin",
        "handler": "game.play"
      }
    },
    {
      "id": "jackie.map_viewer.open",
      "action": {
        "type": "process",
        "program": "powershell.exe",
        "arguments": [
          "-NoProfile",
          "-ExecutionPolicy",
          "Bypass",
          "-File",
          "${RuntimeRoot}/games/jackie/scripts/open-map-viewer.ps1",
          "-GameRoot",
          "${GameRoot}"
        ],
        "workingDirectory": "${RuntimeRoot}"
      }
    },
    {
      "id": "jackie.reload_data",
      "action": {
        "type": "builtin",
        "handler": "studio.reload_definitions"
      }
    }
  ]
}
