{
  "schemaVersion": 1,
  "id": "3e-studio",
  "displayName": "3E Studio",

  "gamesDirectory": "games",
  "projectsDirectory": "../3E-Projects",
  "defaultGameTemplate": "games/_template",
  "defaultUiDirectory": "config/ui/default",

  "autoDiscoverGames": true,

  "liveReload": {
    "enabled": true,
    "debounceMs": 150,
    "watch": [
      "config/**/*.json",
      "games/**/*.json",
      "games/**/*.lua",
      "../3E-Projects/**/*.json"
    ]
  }
}
