        {
          "type": "command",
          "label": "Open Project",
          "command": "project.open"
        },
        {
          "type": "separator"
        },
        {
          "type": "command",
          "label": "Exit",
          "command": "studio.exit"
        }
      ]
    },

    {
      "id": "edit",
      "label": "Edit",
      "items": [
        {
          "type": "command",
          "label": "Undo",
          "command": "edit.undo"
        },
        {
          "type": "command",
          "label": "Redo",
          "command": "edit.redo"
        }
      ]
    },

    {
      "id": "view",
      "label": "View",
      "items": [
        {
          "type": "command",
          "label": "Game Library",
          "command": "panel.games.toggle"
        },
        {
          "type": "command",
          "label": "Project Library",
          "command": "panel.projects.toggle"
        },
        {
          "type": "command",
          "label": "Scene",
          "command": "panel.scene.toggle"
        },
        {
          "type": "command",
          "label": "Outliner",
          "command": "panel.outliner.toggle"
        },
        {
          "type": "command",
          "label": "Properties",
          "command": "panel.properties.toggle"
        },
        {
          "type": "command",
          "label": "Asset Browser",
          "command": "panel.assets.toggle"
